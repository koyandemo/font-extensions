{
    "manifest_version": 3,
    "name": "MM Font Extension",
    "version": "1.0",
    "description": "Favorite font extension.",
    "action": {
      "default_popup": "index.html"
    },
    "background": {
      "service_worker": "src/background.ts"
    },
    "permissions": ["storage", "activeTab", "scripting"],
    "content_scripts": [
      {
        "matches": ["<all_urls>"],
        "js": ["src/content.ts"],
         "run_at": "document_start"
      }
    ],
    "web_accessible_resources": [
    {
      "resources": ["fonts/*"],
      "matches": ["<all_urls>"]
    }
  ]
  }
  